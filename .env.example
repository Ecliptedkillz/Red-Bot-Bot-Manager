# Copy to .env. Existing environment variables take precedence.
BOTMANAGER_PORT=8765
BOTMANAGER_PUBLIC_URL=https://bots.eclipted.com
BOTMANAGER_ADMIN_USERNAME=admin
# Seeds the FIRST admin account only. Later password changes are managed at /admin.
# Replace with a long random password; empty generates the initial password.
BOTMANAGER_PASSWORD=
# Optional full path. Otherwise use caddy.exe in the project, bin/, or PATH.
CADDY_EXE=
